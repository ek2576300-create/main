MAIL_PORT=3020
MAIL_ENDPOINT_PATH=/api/lead
ADMIN_LEADS_PATH=/api/admin/leads
ALLOWED_ORIGINS=https://catalog.askhow.ru
MAIL_API_KEY=
ADMIN_KEY=

# Ящик, с которого уходят письма. SMTP_PASSWORD — пароль приложения
# (id.yandex.ru → Безопасность → Пароли приложений → Почта), обычный пароль
# от аккаунта Яндекс по SMTP не работает.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=askhow-courses@yandex.ru
SMTP_PASSWORD=
# Должен совпадать с SMTP_USER, иначе Яндекс ответит 550 Sender address rejected.
MAIL_FROM=askhow-courses@yandex.ru
# Куда приходят уведомления о новых заявках. Укажите РЕАЛЬНО существующий ящик:
# если его нет, Яндекс примет письмо и вернёт отбивку «554 5.1.1 Unknown user».
MAIL_TO=info@askhow.ru
